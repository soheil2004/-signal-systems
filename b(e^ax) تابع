# -signal-systems
import numpy as np
import matplotlib.pyplot as plt

# دو مقدار مختلف برای a و b
a_values = [1, 2]
b_values = [1, 3]

x = np.linspace(-2, 2, 200)

plt.figure()

for a in a_values:
    for b in b_values:
        y = b * np.exp(a * x)
        plt.plot(x, y)

plt.xlabel("x")
plt.ylabel("f(x) = b * e^(a*x)")
plt.title("نمودار تابع b * e^(a*x) برای مقادیر مختلف a و b")
plt.show()
